datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
enum Gender {
  MALE
  FEMALE
  OTHER
}
model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  avatar       String?
  gender       Gender?
  avatarPublicId  String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)


  chatMembers  ChatMember[]
  messages     Message[]
  latestPoints    LatestPoint[]
  scanLocations  ScanLocation[]
}
model Chat {
  id        String       @id @default(uuid())
  name      String?
  isGroup   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members   ChatMember[]
  messages  Message[]
  latestPoints    LatestPoint[]
}

model ChatMember {
  id        String   @id @default(uuid())
  userId    String
  chatId    String
  isAdmin   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  type        MessageType @default(text)
  text      String?
  voiceUrl  String?
  duration    Int?
  isPlayed    Boolean @default(false)
  attachment String?
  createdAt DateTime @default(now())

  sender    User     @relation(fields: [senderId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])
}
enum MessageType {
  text
  audio
  image
  file
}

model LatestPoint {
  id        String   @id @default(uuid())
  userId    String   
  chatId    String
  latitude  Float?
  longitude Float?
  ts        BigInt?
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id])
  chat      Chat @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

model ScanLocation {
  id        String @id @default(uuid())
  userId    String @unique
  scan      Boolean @default(false)
  distance  Float?
  latitude  Float?
  longitude Float?

  user      User @relation(fields:[userId], references:[id])
}
