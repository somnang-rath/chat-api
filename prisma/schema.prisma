datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  avatar       String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
chatMembers  ChatMember[]
  messages     Message[]
  latestPoints    LatestPoint[]
}

model Chat {
  id        String       @id @default(uuid())
  name      String?
  isGroup   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members   ChatMember[]
  messages  Message[]
  latestPoints    LatestPoint[]
}

model ChatMember {
  id        String   @id @default(uuid())
  userId    String
  chatId    String
  isAdmin   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  text      String?
   voiceUrl  String?
  attachment String?
  createdAt DateTime @default(now())

  sender    User     @relation(fields: [senderId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])
}

model LatestPoint {
  id        String   @id @default(uuid())
  userId    String   
  chatId    String
  latitude  Float?
  longitude Float?
  ts        BigInt?
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id])
  chat      Chat @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}